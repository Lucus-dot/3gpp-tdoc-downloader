# ============================================================================
# tdoc_direct.py 配置文件模板
#
# 用法：把本文件复制/改名为  tdoc_direct.env  或  .env
#       放到【脚本所在目录】或【当前工作目录】下即可被自动读取。
#       也可以用  --env <路径>  显式指定。
# 若找不到配置文件 → 全部使用下面标注的默认值（默认 SCAN_LIMIT=10）。
#
# 格式：每行 KEY=VALUE；# 开头为注释；值可加引号也可不加。
# 命令行参数优先级高于本文件。
# ============================================================================

# ---- L2 兜底「遍历会议目录」的上限 -------------------------------------------------
# 区间未命中时，最多按号码距离顺序逐个 HEAD 探测多少个会议目录。默认 10。
# 设为 0 等于关闭 L2（与 --no-scan 等效）。
SCAN_LIMIT=10

# ---- 指定会议号后，前后各遍历多少个会议目录 ----------------------------------------
# 例如 --meeting R1-126-bis 会遍历该会议「前 5 个 + 自己 + 后 5 个」共最多 11 个目录。默认 5。
NEIGHBOR_RADIUS=5

# ---- 并发数 / 下载超时（秒） --------------------------------------------------------
WORKERS=8
TIMEOUT=90

# ---- 默认输出目录（--out 未给时生效） -------------------------------------------------
OUT=Docs

# ---- 是否启用 L2 兜底遍历（1=启用，0=关闭） ------------------------------------------
SCAN=1

# ---- 索引缓存（会议表 / 规范版本列表 落盘复用，避免每次运行都重抓） ----------------------
# 会议表单页可达 400KB，同一天内重复运行内容不变 → 落盘缓存，换进程/重启 GUI 都不必重抓。
# 1=启用（默认）/ 0=关闭。注意：真正的 zip 下载与 HEAD 存在性校验**不走缓存**，始终实时。
CACHE=1
# 缓存有效期（秒）。默认 604800 = 7 天；0 或负数 = 永不过期。
# 命中缓存时日志会提示；要强制取最新，加命令行参数 --refresh-cache。
CACHE_TTL=604800
# 缓存目录。留空 = <下载根目录>/.tdoc_cache（即 --out 指定的目录下，与下载产物同处）；
# 该目录不可写时，自动退到 <脚本目录>/.tdoc_cache，再退系统临时目录。
# CACHE_DIR=
